---
// "This week" page, drawn from GitHub. The browser asks our own Worker
// (worker/index.js), which holds the GitHub token and returns aggregates:
// private repos only ever show up as counts, never names or messages.
// Cached in the browser for 10 minutes. If anything fails the panel hides.
const user = "aditbajaj";
---

<a class="live" href={`https://github.com/${user}`} target="_blank" rel="noopener noreferrer" data-live>
  <div class="live-head">
    <span class="eyebrow"><span class="signal pulse"></span>LIVE FROM GITHUB / THIS WEEK</span>
    <span class="mood" data-mood></span>
  </div>
  <ol class="week" data-week></ol>
  <p class="live-foot eyebrow muted" data-foot></p>
</a>

<script>
  const root = document.querySelector<HTMLAnchorElement>("[data-live]");

  if (root) {
    const KEY = "gh-live-v7";
    const TTL = import.meta.env.DEV ? 0 : 10 * 60 * 1000; // no browser cache while developing
    const q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;

    type Data = {
      url: string;
      recent: { repo: string; msg: string; date: string }[];
      top: string; topStars: number; years: number;
      days: [string, number][]; // [date, contributions], oldest first, includes private work
      priv: number; // private contributions in the window, a count and nothing else
    };

    // A line about what's going on right now, from the real data. First match wins.
    const mood = (d: Data, streak: number) => {
      const hours = d.recent[0] ? (Date.now() - new Date(d.recent[0].date).getTime()) / 3_600_000 : Infinity;
      if (hours < 2) return "literally just pushed something";
      if (streak >= 3) return `on a ${streak} day run, don’t interrupt`;
      if (hours < 24) return "was in the code today";
      if (hours < 24 * 7) return `last shipped ${Math.round(hours / 24)} days ago`;
      return "taking a breather, probably planning something";
    };

    const load = async (): Promise<Data> => {
      try {
        const c = JSON.parse(localStorage.getItem(KEY) ?? "null");
        if (c && Date.now() - c.t < TTL) return c.d;
      } catch {}

      const res = await fetch("/api/github/");
      if (!res.ok) throw new Error(String(res.status));
      const d: Data = await res.json();
      try {
        localStorage.setItem(KEY, JSON.stringify({ t: Date.now(), d }));
      } catch {}
      return d;
    };

    const el = (tag: string, cls = "", text = "") => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text) e.textContent = text;
      return e;
    };

    // Tally marks: groups of four strokes with a slash through full fives.
    const tally = (n: number, delay: number) => {
      const wrap = el("span", "tally");
      wrap.title = `${n} contribution${n === 1 ? "" : "s"}`;
      const shown = Math.min(n, 20);
      let k = 0;
      for (let left = shown; left > 0; left -= 5) {
        const g = el("span", "tg" + (left >= 5 ? " full" : ""));
        for (let i = 0; i < Math.min(left, 5) - (left >= 5 ? 1 : 0); i++) {
          const s = el("i");
          s.style.setProperty("--r", `${(((k * 7) % 5) - 2) * 0.8}deg`);
          s.style.animationDelay = `${delay + k++ * 28}ms`;
          g.append(s);
        }
        wrap.append(g);
      }
      if (n > 20) wrap.append(el("span", "more", `+${n - 20}`));
      return wrap;
    };

    load()
      .then((d) => {
        root.href = d.url;
        const counts = d.days.map(([, n]) => n);

        let streak = 0; // today may still be empty, so a run can end yesterday
        for (let i = counts.length - 1 - (counts[counts.length - 1] ? 0 : 1); i >= 0 && counts[i]; i--) streak++;
        q("[data-mood]").textContent = mood(d, streak);

        // newest public commit message per day
        const said = new Map<string, string>();
        for (const c of d.recent) {
          const day = c.date.slice(0, 10);
          if (!said.has(day)) said.set(day, c.msg);
        }

        const week = q("[data-week]");
        d.days.slice(-7).forEach(([date, n], i, all) => {
          const li = el("li", i === all.length - 1 ? "today" : "");
          const label = i === all.length - 1
            ? "TODAY"
            : new Date(`${date}T12:00:00`).toLocaleDateString("en", { weekday: "short" }).toUpperCase();
          li.append(el("span", "day", label), n ? tally(n, i * 90) : el("span", "tally"));
          li.append(
            n
              ? el("span", "say", said.get(date) ?? "off the record")
              : el("span", "say none", "quiet"),
          );
          week.append(li);
        });

        const foot = [
          d.topStars && `★ ${d.topStars} on ${d.top}`,
          `${d.years} years on github`,
          d.priv && "a lot of my work is private, so some days look quiet when they weren’t",
        ].filter(Boolean);
        q("[data-foot]").textContent = foot.join(" · ").toUpperCase();
      })
      .catch(() => (root.hidden = true));
  }
</script>
