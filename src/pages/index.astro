---
import { getCollection } from "astro:content";
import ProjectPreview from "../components/ProjectPreview.astro";
import Layout from "../layouts/Layout.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout
  title="Adit Bajaj | Projects"
  description="Projects by Adit Bajaj: FibrumPDF, Iris, Termdash and History Hologram."
>
  <section class="intro wrap" aria-labelledby="intro-title">
    <div class="lead">
      <h1 id="intro-title">Adit Bajaj</h1>
      <p>
        I like taking things apart, figuring out how they work, and building
        something from what I find.
      </p>
      <p>
        Lately that has meant a PDF engine in Go and C that runs 77× faster
        than the parser it replaced, a retrieval system where every answer has
        to cite the page it came from, and a Geometry Dash clone that renders
        itself in Braille inside a terminal. I am still at school and mostly
        self-taught, which mainly means I pick problems that force me to learn
        the thing I wanted to learn next.
      </p>
    </div>

    <article class="credential" aria-labelledby="credential-title">
      <header>
        <img
          src="/ms-badge.svg"
          alt="Microsoft Certified Associate badge"
          width="120"
          height="120"
        />
        <div>
          <p class="eyebrow">Microsoft Certified · Associate</p>
          <h2 id="credential-title">Azure AI Apps and Agents Developer</h2>
        </div>
      </header>

      <ul class="scope" aria-label="Areas covered by exam AI-103">
        <li>Azure AI solution planning</li>
        <li>Generative AI and agents</li>
        <li>Computer vision</li>
        <li>Text analysis</li>
        <li>Information extraction</li>
      </ul>

      <a
        href="https://learn.microsoft.com/api/credentials/share/en-us/AditBajaj-5361/A115DCFABF437CED?sharingId=5A7B3253B57E732D"
        target="_blank"
        rel="noreferrer"
      >
        Verify AI-103 <span aria-hidden="true">↗</span>
      </a>
    </article>

    <ul class="signals" aria-label="At a glance">
      <li>Melbourne</li>
      <li>Go, Rust, Python, C, TypeScript</li>
      <li>100+ stars on GitHub</li>
      <li>GitHub award for most creative project</li>
    </ul>
  </section>

  <section class="projects wrap" id="projects" aria-labelledby="projects-title">
    <h2 id="projects-title">Projects</h2>

    <div class="project-showcase">
      <ol>
        {projects.map((project) => {
          const number = String(project.data.order).padStart(2, "0");

          return (
            <li class="project-item">
              <a class="project-link" href={`/projects/${project.id}/`}>
                <ProjectPreview project={project} />
                <div class="project-heading">
                  <div>
                    <span class="project-number" aria-hidden="true">
                      {number}
                    </span>
                    <h3>{project.data.title}</h3>
                  </div>
                  <span class="project-arrow" aria-hidden="true">↗</span>
                </div>
                <p>{project.data.description}</p>
                <ul class="project-highlights" aria-label={`${project.data.title} highlights`}>
                  {project.data.highlights.map((highlight) => <li>{highlight}</li>)}
                </ul>
                <p class="stack">{project.data.tags.join(" · ")}</p>
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  </section>
</Layout>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.72fr);
    align-items: start;
    column-gap: clamp(2rem, 5vw, 4rem);
    padding-top: clamp(2rem, 4vw, 3.25rem);
    padding-bottom: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  .lead {
    grid-column: 1;
  }

  .lead p {
    max-width: 34rem;
    margin: 1rem 0 0;
  }

  .lead p:first-of-type {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .lead p + p {
    color: var(--muted);
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
  }

  .signals {
    display: flex;
    flex-wrap: wrap;
    grid-column: 1 / -1;
    gap: 0.2rem 0;
    margin: clamp(1.75rem, 4vw, 2.75rem) 0 0;
    padding: 0.7rem 0 0;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    line-height: 1.4;
    list-style: none;
  }

  .signals li {
    font-family: var(--mono);
    white-space: nowrap;
  }

  .signals li:not(:last-child)::after {
    margin-inline: 0.6rem;
    color: var(--line);
    content: "\2022";
  }

  .credential {
    grid-column: 2;
    grid-row: 1;
    margin: 0.4rem 0 0;
    padding: 1rem 1.1rem 1.1rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .credential header {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .credential img {
    width: clamp(3.5rem, 6vw, 4.5rem);
    height: auto;
    flex: 0 0 auto;
  }

  .credential .eyebrow {
    margin: 0 0 0.3rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .credential h2 {
    padding: 0;
    border: 0;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  /* The five areas exam AI-103 measures, in Microsoft's own order. */
  .scope {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0;
    margin: 0.9rem 0 0;
    padding: 0.75rem 0 0;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.68rem;
    line-height: 1.5;
    list-style: none;
  }

  .scope li {
    font-family: var(--mono);
    white-space: nowrap;
  }

  .scope li:not(:last-child)::after {
    margin-inline: 0.45rem;
    color: var(--line);
    content: "\00b7";
  }

  .credential > a {
    display: inline-block;
    margin-top: 0.8rem;
    color: var(--link);
    font-size: 0.8rem;
  }

  .projects {
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
    padding-bottom: clamp(4rem, 10vw, 7rem);
    scroll-margin-top: 2rem;
  }

  .project-showcase {
    margin-top: clamp(0.5rem, 1vw, 0.875rem);
  }

  .project-link :global(.preview-frame) {
    aspect-ratio: 2 / 1;
  }


  .project-link {
    display: block;
    height: 100%;
    text-decoration: none;
  }

  .project-link {
    transition: border-color 200ms ease, transform 200ms ease;
  }

  .project-link:hover,
  .project-link:focus-visible {
    border-color: var(--accent);
    transform: translateY(-0.12rem) rotate(0.8deg) scale(1.015);
  }

  .project-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }

  .project-heading > div {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .project-number {
    color: var(--accent);
    font-family: ui-monospace, monospace;
    font-size: 1rem;
  }


  .project-arrow {
    color: var(--accent);
    opacity: 0;
    transform: translate(-0.3rem, 0.3rem);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .project-link:hover .project-arrow,
  .project-link:focus-visible .project-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  .stack {
    color: #55554f;
    font-size: 0.8rem;
    font-family: var(--mono);
  }

  .project-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0;
    margin: 0.85rem 0 0;
    padding: 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 1.4;
    list-style: none;
  }

  .project-highlights li {
    font-family: var(--mono);
    white-space: nowrap;
  }

  .project-highlights li:not(:last-child)::after {
    margin-inline: 0.5rem;
    color: var(--line);
    content: "·";
  }

  .project-link > p:not(.stack) {
    max-width: 32rem;
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .stack {
    margin: 0.6rem 0 0;
  }


  @media (prefers-reduced-motion: reduce) {
    .project-link,
    .project-arrow,
    .project-link :global(.preview-frame) {
      transition: none;
    }
  }

  @media (max-width: 44rem) {
    .intro {
      display: block;
      padding: 2.25rem 0 1.5rem;
    }

    .credential {
      max-width: 34rem;
      margin-top: 1.75rem;
    }

    .signals {
      margin-top: 1.75rem;
    }

    .project-link :global(.preview-frame) {
      aspect-ratio: 4 / 3;
    }
  }
</style>
