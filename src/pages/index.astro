---
import { getCollection } from "astro:content";
import ProjectPreview from "../components/ProjectPreview.astro";
import Layout from "../layouts/Layout.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout
  title="Adit Bajaj"
  description="Projects by Adit Bajaj: FibrumPDF, Iris, Termdash and History Hologram."
>
  <section class="intro wrap" aria-labelledby="intro-title">
    <div class="lead">
      <h1 id="intro-title">Adit Bajaj</h1>
      <p>
        Hi! I'm Adit. I'm a high-school student in Melbourne. I've been a self-taught programmer since I was 10 and dabbled in lots of things along the way.
      </p> 
      <p class="who">I find this all really interesting, and I'm looking for my first work experience, internship or contribution at a startup. </p>
    </div>

    <article class="credential" aria-labelledby="credential-title">
      <header>
        <img
          src="/ms-badge.svg"
          alt="Microsoft Certified Associate badge"
          width="120"
          height="120"
        />
        <div>
          <p class="eyebrow">Microsoft Certified · Associate</p>
          <h2 id="credential-title">Azure AI Apps and Agents Developer</h2>
        </div>
      </header>

      <ul class="scope" aria-label="Areas covered by exam AI-103">
        <li>Azure AI solution planning, security and optimisation</li>
        <li>Generative AI, NLP and computer vision</li>
        <li>AI agents, tools and MCP</li>
        <li>Hybrid Retrieval Augmented Generation (RAG) pipelines</li>
      </ul>

      <a
        class="wiggle"
        href="https://learn.microsoft.com/api/credentials/share/en-us/AditBajaj-5361/A115DCFABF437CED?sharingId=5A7B3253B57E732D"
        target="_blank"
        rel="noopener noreferrer"
      >
        Verify AI-103 <span aria-hidden="true">↗</span>
      </a>
    </article>
  </section>

  <section class="projects wrap" id="projects" aria-labelledby="projects-title">
    <h2 id="projects-title">Projects</h2>

    <div class="project-showcase">
      <ol>
        {projects.map((project) => {
          const number = String(project.data.order).padStart(2, "0");

          return (
            <li class="project-item">
              <a class="project-link" href={`/projects/${project.id}/`}>
                <ProjectPreview project={project} />
                <div class="project-heading">
                  <div>
                    <span class="project-number" aria-hidden="true">
                      {number}
                    </span>
                    <h3>{project.data.title}</h3>
                  </div>
                  <span class="project-arrow" aria-hidden="true">↗</span>
                </div>
                <p>{project.data.description}</p>
                <ul class="project-highlights" aria-label={`${project.data.title} highlights`}>
                  {project.data.highlights.map((highlight) => <li>{highlight}</li>)}
                </ul>
                <p class="stack">{project.data.tags.join(" · ")}</p>
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="also wrap" aria-labelledby="also-title">
    <h2 id="also-title">Also on GitHub</h2>

    <ul>
      <li>
        <a class="wiggle" href="https://github.com/aditbajaj/rich-soup" target="_blank" rel="noopener noreferrer">rich-soup</a>
        <span>Python</span>
        <p>
          Renders a page first, then extracts JSON or Markdown. BeautifulSoup
          for pages that need JavaScript to exist.
        </p>
      </li>
      <li>
        <a class="wiggle" href="https://github.com/aditbajaj/mtafoubs" target="_blank" rel="noopener noreferrer">mtafoubs</a>
        <span>Go</span>
        <p>
          Moves files to the trash across filesystems on Linux, which the
          freedesktop spec makes harder than it sounds.
        </p>
      </li>
      <li>
        <a class="wiggle" href="https://github.com/aditbajaj/mupdf-prebuilts" target="_blank" rel="noopener noreferrer">mupdf-prebuilts</a>
        <span>C</span>
        <p>
          Prebuilt MuPDF shared libraries, so installing FibrumPDF does not mean
          compiling MuPDF first.
        </p>
      </li>
      <li>
        <a class="wiggle" href="https://github.com/aditbajaj/WinHideDot" target="_blank" rel="noopener noreferrer">WinHideDot</a>
        <span>C#</span>
        <p>
          Watches for dotfiles on Windows and hides them, the way Linux has
          always done it.
        </p>
      </li>
    </ul>
  </section>
</Layout>

<style>
  /* Masthead: identity and credential in one short band, so the project grid
     starts near the top of the page instead of a screen down. */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.62fr);
    align-items: start;
    column-gap: clamp(2rem, 5vw, 4rem);
    padding-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .lead {
    grid-column: 1;
  }

  .lead h1 {
    font-size: clamp(2.75rem, 5.5vw, 4.25rem);
  }

  .lead p {
    max-width: 30rem;
    margin: 0.9rem 0 0;
    font-size: clamp(1.10rem, 2.1vw, 1.3rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .lead .who {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: clamp(0.92rem, 1.3vw, 1rem);
    line-height: 1.5;
    letter-spacing: 0;
  }

  .credential {
    grid-column: 2;
    grid-row: 1;
    margin: 0.35rem 0 0;
    padding: 0.9rem 1rem 1rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .credential header {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .credential img {
    width: clamp(3.25rem, 5.5vw, 4rem);
    height: auto;
    flex: 0 0 auto;
  }

  .credential .eyebrow {
    margin: 0 0 0.3rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .credential h2 {
    padding: 0;
    border: 0;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  /* The areas exam AI-103 measures. */
  .scope {
    margin: 0.8rem 0 0;
    padding: 0.75rem 0 0;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.5;
    list-style: none;
  }

  .scope li {
    padding-left: 0.9rem;
    text-indent: -0.9rem;
  }

  .scope li::before {
    color: var(--accent);
    content: "→ ";
  }

  .credential > a {
    display: inline-block;
    margin-top: 0.8rem;
    color: var(--link);
    font-size: 0.78rem;
  }

  .also {
    padding: clamp(2rem, 4vw, 3rem) 0 clamp(4rem, 9vw, 6rem);
  }

  .also ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(2rem, 5vw, 4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .also li {
    padding: clamp(0.8rem, 1.6vw, 1rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .also li a {
    color: var(--link);
    font-size: 0.92rem;
  }

  .also li span {
    margin-left: 0.55rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .also li p {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .projects {
    padding-top: clamp(2rem, 4vw, 3rem);
    scroll-margin-top: 2rem;
  }

  .project-showcase {
    margin-top: clamp(0.5rem, 1vw, 0.875rem);
  }

  .project-link :global(.preview-frame) {
    aspect-ratio: 2 / 1;
  }


  .project-link {
    display: block;
    height: 100%;
    text-decoration: none;
    transition: border-color 200ms ease, transform 200ms ease;
  }

  .project-link:hover,
  .project-link:focus-visible {
    border-color: var(--accent);
    transform: translateY(-0.12rem) rotate(0.8deg) scale(1.015);
  }

  .project-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }

  .project-heading > div {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .project-number {
    color: var(--accent);
    font-family: ui-monospace, monospace;
    font-size: 1rem;
  }


  .project-arrow {
    color: var(--accent);
    opacity: 0;
    transform: translate(-0.3rem, 0.3rem);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .project-link:hover .project-arrow,
  .project-link:focus-visible .project-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  .stack {
    margin: 0.6rem 0 0;
    color: #55554f;
    font-size: 0.8rem;
    font-family: var(--mono);
  }

  .project-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0;
    margin: 0.85rem 0 0;
    padding: 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 1.4;
    list-style: none;
  }

  .project-highlights li {
    font-family: var(--mono);
    white-space: nowrap;
  }

  .project-highlights li:not(:last-child)::after {
    margin-inline: 0.5rem;
    color: var(--line);
    content: "·";
  }

  .project-link > p:not(.stack) {
    max-width: 32rem;
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
    line-height: 1.45;
  }


  @media (prefers-reduced-motion: reduce) {
    .project-link,
    .project-arrow,
    .project-link :global(.preview-frame) {
      transition: none;
    }
  }

  @media (max-width: 44rem) {
    .intro {
      display: block;
      padding: 2.25rem 0 1.5rem;
    }

    .credential {
      max-width: 34rem;
      margin-top: 1.75rem;
    }

    .also ul {
      grid-template-columns: 1fr;
    }

    .project-link :global(.preview-frame) {
      aspect-ratio: 4 / 3;
    }
  }
</style>
