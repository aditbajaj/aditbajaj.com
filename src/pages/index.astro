---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const all = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const job = all.find((p) => p.id === "outcoach")!;
const projects = all.filter((p) => p.id !== "outcoach");

const tools = [
  ["rich-soup", "PYTHON", "Render the page first. Extract the useful structure after JavaScript has had its say."],
  ["mtafoubs", "GO", "Moving trash across Linux filesystems. A small problem with surprisingly unfriendly edge cases."],
  ["mupdf-prebuilts", "C / CI", "Shared-library releases so using a PDF parser doesn’t start with compiling its dependencies."],
  ["WinHideDot", "C#", "Dotfiles should behave like dotfiles. A watcher that hides them on Windows."],
];
---

<Layout
  title="Adit Bajaj | Engineering Notebook"
  description="Adit Bajaj, Melbourne. Experiments in fast PDF extraction, private retrieval, terminal games and physical storytelling."
>
  <section class="intro-notebook">
    <div class="intro-topline eyebrow">
      <span><span class="signal"></span>OPEN TO INTERESTING WORK</span>
      <span class="muted">MELBOURNE<span class="location-long">, AUSTRALIA</span> / 2026</span>
    </div>
    <div class="name-line"><h1>Adit Bajaj</h1><span class="name-dot"></span></div>
    <div class="intro-bottom">
      <p class="intro-statement">What do I tell you?<br /><em>I just love building.</em></p>
      <p class="intro-bio">
        I’m a high school student in Melbourne, and I’ve been coding since I was 10.
        I like the unglamorous layers: PDF parsers, retrieval pipelines, and the
        exact point where something breaks.
      </p>
      <div class="working-note">
        <span class="eyebrow muted">LOOKING FOR</span>
        <p>
          Work experience, an internship, or a startup to contribute to.
        </p>
      </div>
    </div>
  </section>

  <section id="work" aria-labelledby="job-title">
    <div class="section-label">
      <h2 id="job-title">Work</h2>
      <span class="eyebrow muted">SEP 2026 / PRESENT</span>
    </div>
    <article class="job">
      <div class="job-when">
        <p>Software &amp; AI Engineer</p>
        <p class="muted">Internship, Melbourne</p>
      </div>
      <div class="job-body">
        <div class="job-head">
          <a href={`/projects/${job.id}/`} class="project-title">Outcoach<span aria-hidden="true">↗︎</span></a>
          <span class="click-hint" aria-hidden="true">
            <svg viewBox="0 0 58 34"><path d="M56 6C40 2 20 6 5 25" /><path d="M5 25L7 12" /><path d="M5 25L18 27" /></svg>
            click me!
          </span>
        </div>
        <ul>
          <li>Own Outcoach’s AI employees end to end. Handed a one-line brief, I research the APIs and what the user actually needs, write the product requirements with the founders, derive the features, then design the architecture and build it across every repo (Flutter app, React admin portal, Node backend, agent service, migrations), on shared agent infrastructure I built for future employees.</li>
          <li><strong>Viktor</strong>, an AI social media manager. Researched the Meta Graph API, the platforms’ limits and real club pages, then redesigned it from scheduled posting to coach-triggered posting when clubs turned out not to post timetables. A multimodal Mastra and Gemini agent that turns a coach’s photos and videos into on-brand Facebook and Instagram posts.</li>
          <li><strong>Zoe</strong>, a voice-enabled coaching assistant on OpenAI and Flutter. Scoped from a short brief into a morning briefing for coaches and live dictation that turns a spoken recap into goal progress, attendance and parent feedback.</li>
          <li>Designed human-in-the-loop approval, undo, audit logging and role-based access, so nothing reaches parents until a coach signs off.</li>
          <li>Found and reported critical authentication bypass, privilege escalation, SQL injection and data exposure bugs, then verified the fixes. Every PR ships with its merge order, env secrets and known test failures.</li>
        </ul>
      </div>
      <aside class="job-side" aria-label="Screenshots">
        <a href={`/projects/${job.id}/`} class="side-shot">
          <img src="/outcoach/zoe-side.webp" alt="A coach asks Zoe &quot;How is Ann doing?&quot; and gets Ann's card with her goals" width="490" height="880" loading="lazy" />
          <span class="eyebrow muted">ZOE / ASK ABOUT ANY STUDENT</span>
        </a>
      </aside>
    </article>
  </section>

  <section id="projects" aria-labelledby="work-title">
    <div class="section-label">
      <h2 id="work-title">Selected experiments</h2>
      <span class="eyebrow muted">{String(projects.length).padStart(2, "0")} PROJECTS / NOT JUST THE HAPPY PATH</span>
    </div>
    {projects.map((project) => {
      const number = String(project.data.order).padStart(2, "0");
      const href = `/projects/${project.id}/`;
      const { title, category, summary, highlights, preview } = project.data;
      return (
        <article class="project-entry">
          <span class="project-index">{number} /</span>
          <div class="project-details">
            <p class="eyebrow muted">{category}</p>
            <a href={href} class="project-title">{title}<span aria-hidden="true">↗︎</span></a>
            <p class="project-summary">{summary}</p>
            <div class="project-tags">{highlights.slice(0, 2).map((h) => <span>{h}</span>)}</div>
          </div>
          <a href={href} class="project-media" aria-label={`Explore ${title}`}>
            {preview ? (
              <>
                <img src={preview.src} alt={preview.alt} loading="lazy" style={`object-fit:${preview.fit}`} />
                <span class="media-caption">{number} / {title.toUpperCase()}</span>
              </>
            ) : (
              <div class="fibrum-visual">
                <div class="eyebrow muted">LESS WAITING. SAME USEFUL STRUCTURE.</div>
                <div class="throughput">318<small>PAGES / SEC</small></div>
                <div class="fibrum-flow"><span>PDF</span>→<span>MuPDF + Go</span>→<span>JSON</span></div>
                <div class="fibrum-bottom"><span>77× PYMUPDF4LLM</span><span>REPOSITORY BENCHMARK</span></div>
              </div>
            )}
          </a>
        </article>
      );
    })}
  </section>

  <section class="credentials-band">
    <div class="credential-line">
      <img src="/ms-badge.svg" alt="Microsoft Certified Associate badge" width="55" height="55" />
      <div>
        <p class="eyebrow muted">MICROSOFT CERTIFIED / AI-103</p>
        <h3>Azure AI Apps and Agents Developer</h3>
        <a href="https://learn.microsoft.com/api/credentials/share/en-us/AditBajaj-5361/A115DCFABF437CED?sharingId=5A7B3253B57E732D" target="_blank" rel="noopener noreferrer">VERIFY CREDENTIAL ↗︎</a>
      </div>
    </div>
    <p class="intro-bio">Agents, tools and MCP. Generative AI, NLP and computer vision. Hybrid RAG pipelines. Planning, securing and evaluating AI systems.</p>
  </section>

  <section>
    <div class="section-label">
      <h2>Smaller rabbit holes</h2>
      <a class="eyebrow muted" href="https://github.com/aditbajaj" target="_blank" rel="noopener noreferrer">ON GITHUB ↗︎</a>
    </div>
    <div class="small-tools">
      {tools.map(([name, lang, text]) => (
        <a class="tool" href={`https://github.com/aditbajaj/${name}`} target="_blank" rel="noopener noreferrer">
          <h3>{name}<span aria-hidden="true">↗︎</span></h3>
          <p>{text}</p>
          <span class="eyebrow">{lang}</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
