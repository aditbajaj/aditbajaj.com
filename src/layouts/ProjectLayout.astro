---
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";

interface Props {
  project: CollectionEntry<"projects">;
  headings: MarkdownHeading[];
}

const { project, headings } = Astro.props;
const { title, description, year, repo, order, category, deck, stack, stats } = project.data;
const number = String(order).padStart(2, "0");
const job = order === 0;
// The table of contents is the article's own h2s, so it can never drift from the MDX.
const sections = headings.filter((heading) => heading.depth === 2);
---

<Layout title={`${title} | Adit Bajaj`} description={description}>
  <section class="case-top">
    <a href={job ? "/#work" : "/#projects"} class="back-link">{job ? "← Work" : "← Selected work"}</a>
    <div class="case-title-row">
      <div>
        <p class="eyebrow muted">{job ? "" : `FIELD NOTE ${number} / `}{category}</p>
        <h1>{title}</h1>
      </div>
      {!job && <span class="case-number" aria-hidden="true">{number}</span>}
    </div>
    <p class="case-deck">{deck}</p>
    <div class="case-meta">
      <span>{stack}</span>
      <span>{year}</span>
      <span>{repo ? "OPEN SOURCE" : "PRIVATE PROJECT"}</span>
    </div>
    {repo && (
      <a class="repo-link" href={repo} target="_blank" rel="noopener noreferrer">
        Repository <span aria-hidden="true">↗</span>
      </a>
    )}
    <div class="case-stats">
      {stats.map(([value, label]) => (
        <div class="case-stat"><strong>{value}</strong><span>{label}</span></div>
      ))}
    </div>
  </section>

  <div class="case-layout">
    <aside class="case-toc">
      <p class="toc-heading">IN THIS NOTE</p>
      <nav aria-label="Article contents">
        {sections.map((heading, i) => (
          <a href={`#${heading.slug}`}>{String(i + 1).padStart(2, "0")} / {heading.text}</a>
        ))}
      </nav>
    </aside>
    <article class="content">
      <slot />
    </article>
  </div>
</Layout>
