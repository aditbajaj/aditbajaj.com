---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title = "Adit Bajaj",
  description = "Software projects by Adit Bajaj.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&amp;family=IBM+Plex+Sans:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500&amp;display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>

  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="wordmark" href="/" aria-label="Adit Bajaj, home">AB</a>
        <nav aria-label="Primary navigation">
          <a href="/#projects">Projects</a>
          <a
            href="https://github.com/aditbajaj"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src="/github.png" width="20">
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
  }

  .header-inner a {
    color: var(--muted);
    font-size: 0.875rem;
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 1.5rem);
  }

  .header-inner a:hover,
  .header-inner a:focus-visible {
    color: var(--text);
  }

  .header-inner .wordmark {
    color: var(--text);
    font-size: 1rem;
    font-weight: 700;
  }
</style>
