---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title = "Adit Bajaj",
  description = "Software projects by Adit Bajaj.",
} = Astro.props;

// Astro.site is undefined if the config has not been picked up (a dev server
// started before it was added), and a bare new URL() there takes the whole page
// down with "Invalid URL". The tags are better skipped than fatal.
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Adit Bajaj" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme;
        }
      } catch {}
    </script>
    <title>{title}</title>

    <!-- Oddly, in development mode, fonts seem to have a delay to load;
      causing a flash of fallback font. CSS that made visibility none for ~60-70ms fixed this,
      and the page remained stable. But when deployed to Cloudflare,
      the page actually now had a flash of blank (white); which also looked bad.
      If you do nothing when it's deployed, it seems to be perfectly find;
      so here, on development only, JS is executed to block the page till fonts load.
      yes, I tried font-display & other stuff, this was the only solution.
       -->
    {
      import.meta.env.DEV && (
        <>
          <style is:inline>
            html[data-fonts-loading] body {
              visibility: hidden;
            }
          </style>
          <script is:inline>
            document.documentElement.dataset.fontsLoading = "";

            (async () => {
              try {
                await Promise.all([...document.fonts].map((font) => font.load()));
                await document.fonts.ready;
              } finally {
                delete document.documentElement.dataset.fontsLoading;
              }
            })();
          </script>
        </>
      )
    }
  </head>

  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="wordmark" href="/" aria-label="Adit Bajaj, home">AB</a>
        <nav aria-label="Primary navigation">
          <a href="/#projects">Projects</a>
          <a href="mailto:adit.bajaj04@gmail.com">Contact</a>
          <a
            href="https://github.com/aditbajaj"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src="/github.png" alt="GitHub" width="20" height="20" />
          </a>
          <button class="theme-toggle" type="button" aria-label="Toggle dark theme">
            <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
            </svg>
            <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>Adit Bajaj &middot; Melbourne</p>
        <nav aria-label="Contact">
          <a href="mailto:adit.bajaj04@gmail.com">adit.bajaj04@gmail.com</a>
          <a
            href="https://github.com/aditbajaj"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
        </nav>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const system = matchMedia("(prefers-color-scheme: dark)");

      const current = () => root.dataset.theme ?? (system.matches ? "dark" : "light");

      // Choosing the theme the system already has clears the stored choice,
      // so the page goes back to following the system.
      document.querySelector(".theme-toggle")?.addEventListener("click", () => {
        const next = current() === "dark" ? "light" : "dark";
        const followsSystem = next === (system.matches ? "dark" : "light");

        if (followsSystem) delete root.dataset.theme;
        else root.dataset.theme = next;

        try {
          if (followsSystem) localStorage.removeItem("theme");
          else localStorage.setItem("theme", next);
        } catch {}
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
  }

  .header-inner a {
    color: var(--muted);
    font-size: 0.875rem;
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 1.5rem);
  }

  .header-inner a:hover,
  .header-inner a:focus-visible {
    color: var(--text);
  }

  .header-inner img {
    filter: var(--icon-filter);
    opacity: 0.85;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    color: var(--text);
  }

  .theme-toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Which icon shows is a token, so it flips with the theme without a
     second copy of every dark selector here. */
  .theme-toggle .moon {
    display: var(--moon-display);
  }

  .theme-toggle .sun {
    display: var(--sun-display);
  }

  .header-inner .wordmark {
    color: var(--text);
    font-size: 1rem;
    font-weight: 700;
  }

  /* The page used to stop dead after the last section. This gives it a floor,
     and a second place to find the address without scrolling back up. */
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1.25rem;
    flex-wrap: wrap;
  }

  .footer-inner p {
    margin: 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-inner nav {
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  .footer-inner a {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .footer-inner a:hover,
  .footer-inner a:focus-visible {
    color: var(--accent);
  }
</style>
