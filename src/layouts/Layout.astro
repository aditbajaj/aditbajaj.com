---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title = "Adit Bajaj",
  description = "Software projects by Adit Bajaj.",
} = Astro.props;

// Astro.site is undefined if the config has not been picked up (a dev server
// started before it was added), and a bare new URL() there takes the whole page
// down with "Invalid URL". The tags are better skipped than fatal.
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Adit Bajaj" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme;
        }
      } catch {}
    </script>
    <title>{title}</title>

    <!-- Oddly, in development mode, fonts seem to have a delay to load;
      causing a flash of fallback font. CSS that made visibility none for ~60-70ms fixed this,
      and the page remained stable. But when deployed to Cloudflare,
      the page actually now had a flash of blank (white); which also looked bad.
      If you do nothing when it's deployed, it seems to be perfectly find;
      so here, on development only, JS is executed to block the page till fonts load.
      yes, I tried font-display & other stuff, this was the only solution.
       -->
    {
      import.meta.env.DEV && (
        <>
          <style is:inline>
            html[data-fonts-loading] body {
              visibility: hidden;
            }
          </style>
          <script is:inline>
            document.documentElement.dataset.fontsLoading = "";

            (async () => {
              try {
                await Promise.all([...document.fonts].map((font) => font.load()));
                await document.fonts.ready;
              } finally {
                delete document.documentElement.dataset.fontsLoading;
              }
            })();
          </script>
        </>
      )
    }
  </head>

  <body>
    <header class="site-header">
      <div class="site-wrap header-inner">
        <a href="/" class="brand" aria-label="Adit Bajaj, home">
          <span class="brand-mark">ab.</span>
          <span class="brand-name">ADIT BAJAJ<br /><span class="muted">ENGINEERING NOTEBOOK</span></span>
        </a>
        <nav class="header-nav" aria-label="Main navigation">
          <a href="https://github.com/aditbajaj" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a class="social-link" href="https://www.linkedin.com/in/adit-bajaj-13ab5832a/" target="_blank" rel="noopener noreferrer" aria-label="Adit on LinkedIn">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
            <span>LinkedIn ↗</span>
          </a>
          <a class="contact-link" href="mailto:adit.bajaj04@gmail.com" aria-label="Email Adit">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" /></svg>
            <span>Let’s talk</span>
          </a>
          <button class="theme-toggle" type="button" aria-label="Toggle dark theme">
            <svg class="moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
            </svg>
            <svg class="sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main class="site-wrap reveal">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-wrap">
        <div class="footer-top">
          <div>
            <p class="eyebrow">HAVE SOMETHING INTERESTING?</p>
            <h2 class="footer-heading">Let’s figure it out.</h2>
          </div>
          <a class="footer-email" href="mailto:adit.bajaj04@gmail.com">adit.bajaj04@gmail.com ↗</a>
        </div>
        <div class="footer-bottom">
          <span>ADIT BAJAJ / MELBOURNE</span>
          <div class="footer-links">
            <a class="social-link" href="https://www.linkedin.com/in/adit-bajaj-13ab5832a/" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
              <span>LINKEDIN ↗</span>
            </a>
            <a href="https://github.com/aditbajaj" target="_blank" rel="noopener noreferrer">MORE EXPERIMENTS ON GITHUB ↗</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const system = matchMedia("(prefers-color-scheme: dark)");

      const current = () => root.dataset.theme ?? (system.matches ? "dark" : "light");

      // Choosing the theme the system already has clears the stored choice,
      // so the page goes back to following the system.
      document.querySelector(".theme-toggle")?.addEventListener("click", () => {
        const next = current() === "dark" ? "light" : "dark";
        const followsSystem = next === (system.matches ? "dark" : "light");

        if (followsSystem) delete root.dataset.theme;
        else root.dataset.theme = next;

        try {
          if (followsSystem) localStorage.removeItem("theme");
          else localStorage.setItem("theme", next);
        } catch {}
      });
    </script>
  </body>
</html>
