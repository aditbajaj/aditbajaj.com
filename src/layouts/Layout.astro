---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title = "Adit Bajaj",
  description = "Software projects by Adit Bajaj.",
} = Astro.props;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Oddly, in development mode, fonts seem to have a delay to load;
      causing a flash of fallback font. CSS that made visibility none for ~60-70ms fixed this,
      and the page remained stable. But when deployed to Cloudflare,
      the page actually now had a flash of blank (white); which also looked bad.
      If you do nothing when it's deployed, it seems to be perfectly find;
      so here, on development only, JS is executed to block the page till fonts load.
      yes, I tried font-display & other stuff, this was the only solution.
       -->
    {
      import.meta.env.DEV && (
        <>
          <style is:inline>
            html[data-fonts-loading] body {
              visibility: hidden;
            }
          </style>
          <script is:inline>
            document.documentElement.dataset.fontsLoading = "";

            (async () => {
              try {
                await Promise.all([...document.fonts].map((font) => font.load()));
                await document.fonts.ready;
              } finally {
                delete document.documentElement.dataset.fontsLoading;
              }
            })();
          </script>
        </>
      )
    }
  </head>

  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="wordmark" href="/" aria-label="Adit Bajaj, home">AB</a>
        <nav aria-label="Primary navigation">
          <a href="/#projects">Projects</a>
          <a
            href="https://github.com/aditbajaj"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src="/github.png" width="20">
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    min-height: 4rem;
    align-items: center;
    justify-content: space-between;
  }

  .header-inner a {
    color: var(--muted);
    font-size: 0.875rem;
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 1.5rem);
  }

  .header-inner a:hover,
  .header-inner a:focus-visible {
    color: var(--text);
  }

  .header-inner .wordmark {
    color: var(--text);
    font-size: 1rem;
    font-weight: 700;
  }
</style>
