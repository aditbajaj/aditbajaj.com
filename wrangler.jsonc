{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aditbajaj-com",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GITHUB_USER": "aditbajaj"
  },
  "observability": {
    "enabled": true
  }
}
